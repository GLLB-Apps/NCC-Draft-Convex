# Apache-regler för webroot (public_html) på Inleed.
#
# Till skillnad från PHP-versionen finns INGET /api att routa, och inga
# data/database/uploads-kataloger att skydda — hela backenden är Convex, nåbar
# direkt från webbläsaren via VITE_CONVEX_URL. Den här filen gör bara två
# saker: lite grundsäkerhet, och SPA-fallback åt React Router.

Options -Indexes
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Statiska filer serveras direkt.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Allt annat till React-appens index.html (klientens egen routing).
    RewriteRule ^ index.html [L]
</IfModule>
